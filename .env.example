# ============================================================
# 智能体驱动的 AI 安全知识情报系统 · 环境变量模板（来源：PROJECT_PLAN.md §11.1）
# 用法：copy .env.example .env  然后按需填写；.env 已被 .gitignore / .clineignore 排除
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true                    # true：输出 JSON 结构化日志（含 trace_id）
DEGRADED_MODE=false              # true 时：SQLite + 内存 Chroma + 跳过多跳 Reasoner

# ---------- PostgreSQL（可降级为 SQLite） ----------
STORAGE_BACKEND=postgres         # postgres | sqlite
PG_DSN=postgresql+asyncpg://aisec:aisec@localhost:5432/aisec
# SQLITE_DSN=sqlite+aiosqlite:///./data/aisec.db

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aisec_dev_pwd
NEO4J_ENABLED=true               # false 时图谱查询降级为 PG JSON（跳数 ≤2）

# ---------- ChromaDB ----------
VECTOR_BACKEND=chroma_persistent # chroma_persistent | chroma_memory
CHROMA_PATH=./data/chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- LLM（云端主 / 本地兜底；切换只需改本段，代码零改动） ----------
LLM_PROVIDER=deepseek            # deepseek | qwen | zhipu | ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_SMART=deepseek-reasoner
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# 结构化输出方式（with_structured_output 的 method）：
#   DeepSeek 必填 function_calling —— 官方 API 不支持 response_format=json_schema，
#   用库默认 json_schema 会报 400 "This response_format type is unavailable now"；
#   OpenAI 可留空（auto → json_schema，原生最严格）；
#   deepseek-reasoner 等思考型模型自动回退 json_mode（不支持 tool_choice）。
#   可选值：auto | function_calling | json_mode | json_schema
LLM_STRUCTURED_METHOD=function_calling
ENRICH_DAILY_BUDGET=2000000      # token 日预算，超出自动暂停富化
ENRICH_MIN_CONFIDENCE=0.7        # 富化自动通过阈值（低于该值触发回流，§3.2 闸门④）
ENRICH_MAX_ROUNDS=2              # 富化最大回流次数（防死循环：verifier → poc_seeker）

# ---------- 采集 ----------
NVD_API_KEY=                     # 未申请到时留空，走 5 req/30s 令牌桶
NVD_RATE_LIMIT_NO_KEY=5/30
NVD_RATE_LIMIT_WITH_KEY=50/30
COLLECT_DEFAULT_DAYS=7
RAW_SNAPSHOT_DIR=./data/raw

# ---------- 采集（P3 扩展） ----------
AI_PACKAGE_WATCHLIST=vllm,ollama,transformers,langchain,torch   # OSV 按包查询
GITHUB_TOKEN=                    # GHSA GraphQL 必需（未配置时 ghsa 源跳过）

# ---------- 中间件口令（docker-compose 读取；保留默认值即可本地起容器） ----------
PG_USER=aisec
PG_PASSWORD=aisec
PG_DB=aisec
PG_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
CHROMA_PORT=8000

# ---------- 服务 ----------
API_BASE_URL=http://localhost:8000/api/v1

# ============================================================
# 离线兜底示例（现场断网时改这三行即可，详见 §3.3）
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL_FAST=qwen2.5:7b
#   LLM_MODEL_SMART=deepseek-r1:7b
#   LLM_TIMEOUT_S=180
# ============================================================
